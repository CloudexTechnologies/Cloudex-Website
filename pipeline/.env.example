# Copy to .env on the VPS and fill in. Never commit the real file.

# Sanity — write token from https://sanity.io/manage → API → Tokens (Editor role)
SANITY_PROJECT_ID=so1isjsl
SANITY_DATASET=production
SANITY_WRITE_TOKEN=

# Site
SITE_URL=https://cloudextechnologies.io
# Optional: matches the secret set on the Sanity webhook / Vercel env var.
# Without it the site still updates within its 5-minute ISR window.
SANITY_REVALIDATE_SECRET=

# Hermes
HERMES_HOME=/home/ubuntu/.hermes
HERMES_PYTHON=/home/ubuntu/.hermes/hermes-agent/venv/bin/python
NOTIFY_TARGET=whatsapp:50264253931680@lid
# Leave blank to use the Hermes default model.
HERMES_MODEL=

# Codex
CODEX_BIN=/home/ubuntu/.local/bin/codex
NODE_BIN_DIR=/home/ubuntu/.nvm/versions/node/v24.16.0/bin

# Editorial policy
RESEARCH_SHARE=0.7
RATIO_WINDOW=10
GATE_PASS_SCORE=78
MAX_REVISIONS=1
DEFAULT_AUTHOR_ID=author-cloudex-research-desk
