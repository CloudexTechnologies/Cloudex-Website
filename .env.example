# Cloudex Technologies website. Copy to `.env.local` for local dev and set the same
# variables in production. `.env*` is gitignored, so real values are never committed.

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://cloudextechnologies.io

# ── Sanity (insights) ─────────────────────────────────────────────────────────
# The production dataset is public, so reads need no token.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional: same value as the Sanity webhook, to revalidate in seconds instead of 5 minutes.
# SANITY_REVALIDATE_SECRET=

# ── Contact form -> cloudex-mail Worker ───────────────────────────────────────
# Mail goes through the Worker's HTTP API (POST /api/send), not SMTP.
# The key is in ~/cloudex-mail/.env as CLOUDEX_MAIL_API_KEY.
CLOUDEX_MAIL_URL=https://mail.cloudextechnologies.io
CLOUDEX_MAIL_API_KEY=
# Must be an active mailbox in the Worker.
CONTACT_FROM=info@cloudextechnologies.io
CONTACT_TO=info@cloudextechnologies.io
