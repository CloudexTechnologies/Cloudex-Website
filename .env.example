# Cloudex Technologies website. Copy to `.env.local` for local dev and set the same
# variables in production. `.env*` is gitignored, so real values are never committed.

# ── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://cloudextechnologies.io

# ── Sanity (insights) ─────────────────────────────────────────────────────────
# The production dataset is public, so reads need no token.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional: same value as the Sanity webhook, to revalidate in seconds instead of 5 minutes.
# SANITY_REVALIDATE_SECRET=

# ── Contact form -> SMTP mailbox ──────────────────────────────────────────────
SMTP_HOST=
# 587 = STARTTLS (usual), 465 = implicit TLS
SMTP_PORT=587
# SMTP_SECURE=
SMTP_USER=info@cloudextechnologies.io
SMTP_PASS=
# Set to "false" ONLY if the mail server uses a self-signed certificate.
# SMTP_TLS_REJECT_UNAUTHORIZED=false
# Envelope sender: must be a mailbox on your own domain or SPF/DKIM will fail.
CONTACT_FROM="Cloudex Technologies Website <info@cloudextechnologies.io>"
CONTACT_TO=info@cloudextechnologies.io
